# ----- 9Router (upstream gateway) -----
# URL of the 9Router instance. Local default is port 20128.
NINEROUTER_URL=http://localhost:20128

# API key from Dashboard → Keys. Leave empty if the instance has requireApiKey=false.
NINEROUTER_KEY=

# ----- Indonesian TTS + local Whisper STT service (optional) -----
# Local FastAPI service in `idn-tts/` (Coqui TTS + g2p-id + Whisper large-v3).
# When reachable, the TTS panel shows extra `coqui/<speaker>` voices and
# the STT panel gains a `local/whisper-large-v3` option.
IDN_TTS_URL=http://localhost:21128
IDN_TTS_ENABLED=true

# ----- This dashboard app -----
# Where the FastAPI backend listens.
APP_HOST=127.0.0.1
APP_PORT=8765

# Folder for generated images/audio and the history DB.
DATA_DIR=./data

# Default models (override per-call from the UI). Leave blank to pick first available.
DEFAULT_CHAT_MODEL=
DEFAULT_IMAGE_MODEL=
# Use coqui/wibowo (Indonesian) when idn-tts service is running; leave blank for auto.
DEFAULT_TTS_MODEL=coqui/wibowo
# Use local/whisper-large-v3 (local Whisper) when idn-tts service is running.
DEFAULT_STT_MODEL=local/whisper-large-v3
DEFAULT_EMBEDDING_MODEL=
DEFAULT_SEARCH_MODEL=
DEFAULT_FETCH_MODEL=

# Request timeout (seconds) for long calls like image gen.
REQUEST_TIMEOUT=180
